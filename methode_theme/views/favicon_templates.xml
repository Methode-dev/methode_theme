<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-tab and home-screen icons.

    Stock Odoo emits exactly ONE icon link, in web.layout
    (web/views/webclient_templates.xml:23):

        <link type="image/x-icon" rel="shortcut icon"
              t-att-href="x_icon or '/web/static/img/favicon.ico'"/>

    Every page in this install goes through that template — backend, login,
    the branded 404 (error_templates.xml), portal — so retargeting it here is
    the whole tab icon in one xpath.  The rest of this file is the two surfaces
    web.layout does NOT cover: the iOS home-screen icon on the webclient
    (hardcoded to odoo-icon-ios.png in web.webclient_bootstrap) and on the
    frontend (no apple-touch-icon at all in stock).

    ⚠ KEEP THE `x_icon or` FALLBACK CHAIN.  x_icon is stock's own hook: the
    website module sets it from res.website.favicon, and /scoped_app_icon_png
    sets it for an installed scoped app.  Dropping it would make this file
    outrank a favicon a later module legitimately owns, in a way that only
    shows up once that module is installed.  We are the *default*, not the
    override.

    ⚠ THE PWA MANIFEST ICONS ARE NOT HERE.  <link rel="manifest"> points at
    /web/manifest.webmanifest, which is generated in Python, so the
    android-chrome-*.png pair is wired up in controllers/webmanifest.py
    instead.  Both halves read from the same static/src/img/favicon/ directory.

    Source files are favicon.io output for the Méthode mark; regenerate the
    whole set from there rather than resizing one of them by hand.
-->
<odoo>

    <template id="layout_favicon" inherit_id="web.layout" name="Méthode favicon">
        <xpath expr="//head/link[@rel='shortcut icon']" position="replace">
            <link type="image/x-icon" rel="shortcut icon"
                  t-att-href="x_icon or '/methode_theme/static/src/img/favicon/favicon.ico'"/>
            <!--
                The .ico above is the compatibility floor (it carries 16 and 32
                px frames).  These two let a modern browser pick a PNG instead,
                which is what actually renders crisply on a HiDPI tab strip.

                ⚠ Inside a t-if, so they are direct children of <t>, NOT of
                <head>.  That is load-bearing: web.frontend_layout inserts the
                fontawesome preload at `//head/link[last()]`, and if these were
                bare head children the *16x16* link would become "last" and the
                preload would land between the icon links.  Harmless today,
                but it makes a stock xpath's anchor depend on this file.
            -->
            <t t-if="not x_icon">
                <link rel="icon" type="image/png" sizes="32x32"
                      href="/methode_theme/static/src/img/favicon/favicon-32x32.png"/>
                <link rel="icon" type="image/png" sizes="16x16"
                      href="/methode_theme/static/src/img/favicon/favicon-16x16.png"/>
            </t>
        </xpath>
    </template>

    <!--
        Backend.  Stock ships `<link rel="apple-touch-icon"
        href="/web/static/img/odoo-icon-ios.png"/>` inside the head_web t-set
        of web.webclient_bootstrap; retargeted rather than replaced so the
        element keeps whatever else stock decides to put on it.
    -->
    <template id="webclient_bootstrap_favicon" inherit_id="web.webclient_bootstrap"
              name="Méthode home-screen icon (backend)">
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/methode_theme/static/src/img/favicon/apple-touch-icon.png</attribute>
        </xpath>
    </template>

    <!--
        Frontend — the login page, the QCM walkthrough and the 404.  Stock has
        no apple-touch-icon here at all, so this is an add, not an override:
        the login page is where a prospect on a phone would "Add to Home
        Screen", and without this iOS screenshots the page instead.

        Anchored on frontend_layout's own preload link (the node it inserts at
        //head/link[last()]) because that is the one element this template is
        guaranteed to own.
    -->
    <template id="frontend_layout_favicon" inherit_id="web.frontend_layout"
              name="Méthode home-screen icon (frontend)">
        <xpath expr="//head/link[@rel='preload']" position="after">
            <link rel="apple-touch-icon"
                  href="/methode_theme/static/src/img/favicon/apple-touch-icon.png"/>
        </xpath>
    </template>

</odoo>

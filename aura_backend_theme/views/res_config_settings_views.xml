<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_tbt_branding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tbt.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']/div[@id='companies']" position="after">
                <div id="tbt_branding">
                    <block title="Backend Theme" name="tbt_branding_setting_container" groups="base.group_system">
                        <setting id="tbt_brand_color_setting"
                                 string="Brand Color"
                                 company_dependent="1"
                                 help="Primary brand color used by Aura Backend Theme - Community Edition.">
                            <div class="d-flex align-items-center gap-2">
                                <field name="tbt_brand_color" widget="color" class="w-auto m-0"/>
                                <field name="tbt_brand_color" placeholder="#242424" class="w-25"/>
                                <button name="action_reset_tbt_brand_color"
                                        type="object"
                                        string="Reset to Default Blue"
                                        class="btn btn-secondary"/>
                            </div>
                            <div class="text-muted mt8">Use a hex color code, e.g. #242424.</div>
                        </setting>

                        <setting id="tbt_sidebar_dark_setting"
                                 string="Dark Sidebar"
                                 company_dependent="1"
                                 help="Switch the sidebar to a dark palette while keeping text and icons readable.">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <field name="tbt_sidebar_dark_mode" class="w-auto m-0"/>
                                <button name="action_toggle_tbt_sidebar_dark"
                                        type="object"
                                        string="Toggle Dark Sidebar"
                                        class="btn btn-secondary"/>
                                <span class="text-muted">Enable for a darker left navigation similar to the reference.</span>
                            </div>
                        </setting>

                        <setting id="tbt_topbar_color_setting"
                                 string="Topbar Colors"
                                 company_dependent="1"
                                 help="Adjust top navigation background and text colors.">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Background</span>
                                    <field name="tbt_topbar_bg" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_topbar_bg" placeholder="#ffffff" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Text</span>
                                    <field name="tbt_topbar_text" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_topbar_text" placeholder="#0c0f0f" class="w-25"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="tbt_background_color_setting"
                                 string="Content &amp; Surface Colors"
                                 company_dependent="1"
                                 help="Set base backgrounds used in forms, list pages and cards.">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Content Background</span>
                                    <field name="tbt_content_bg" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_content_bg" placeholder="#f6f6f6" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Card Surface</span>
                                    <field name="tbt_card_bg" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_card_bg" placeholder="#ffffff" class="w-25"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="tbt_dashboard_card_color_setting"
                                 string="Dashboard Stat Card Colors"
                                 company_dependent="1"
                                 help="Set the accent background colors used by dashboard stat cards 1 through 4.">
                            <div class="d-flex flex-column gap-3">
                              <div class="d-flex align-items-center gap-2">
                                <field name="tbt_dashboard_card_solid"/>
                                <span class="text-muted">Use solid card backgrounds</span>
                              </div>
                              <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Card 1</span>
                                    <field name="tbt_dashboard_card_1_color" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_dashboard_card_1_color" placeholder="#2F6BFF" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Card 2</span>
                                    <field name="tbt_dashboard_card_2_color" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_dashboard_card_2_color" placeholder="#EF4444" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Card 3</span>
                                    <field name="tbt_dashboard_card_3_color" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_dashboard_card_3_color" placeholder="#F59E0B" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Card 4</span>
                                    <field name="tbt_dashboard_card_4_color" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_dashboard_card_4_color" placeholder="#22C55E" class="w-25"/>
                                </div>
                                <button name="action_reset_tbt_dashboard_card_colors"
                                        type="object"
                                        string="Reset Card Colors"
                                        class="btn btn-secondary"/>
                              </div>
                            </div>
                        </setting>

                        <setting id="tbt_login_split_setting"
                                 string="Login Page"
                                 company_dependent="1"
                                 help="Choose whether the login page uses the branded split-screen layout.">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <field name="tbt_login_split_enabled" class="w-auto m-0"/>
                                <span class="text-muted">Enable the split layout with the brand panel on the login page.</span>
                            </div>
                            <div class="mt-3" invisible="not tbt_login_split_enabled">
                                <span class="text-muted d-block mb-2">Login Logo (Global)</span>
                                <field name="tbt_login_logo_global" widget="image" class="oe_avatar"
                                       options="{'preview_image': 'tbt_login_logo_global'}"/>
                                <div class="text-muted mt-1">Used on split login for all companies. Falls back to company logo if empty.</div>
                            </div>
                            <div class="mt-3" invisible="not tbt_login_split_enabled">
                                <span class="text-muted d-block mb-2">Left Panel Background Image</span>
                                <field name="tbt_login_background_image" widget="image" class="oe_avatar"
                                       options="{'preview_image': 'tbt_login_background_image'}"/>
                                <div class="text-muted mt-1">If empty, the default gradient background is used.</div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mt-2" invisible="not tbt_login_split_enabled">
                                    <field name="tbt_login_background_enabled" class="w-auto m-0"/>
                                    <span class="text-muted">Use uploaded image in split screen.</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mt-1" invisible="not tbt_login_split_enabled">
                                    <field name="tbt_login_background_pattern" class="w-auto m-0"/>
                                    <span class="text-muted">Show circular pattern over image.</span>
                                </div>
                            </div>
                        </setting>

                        <setting id="tbt_login_signup_setting"
                                 string="Login Links"
                                 company_dependent="1"
                                 help="Choose whether the create account link appears on the login page.">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <field name="tbt_login_show_signup" class="w-auto m-0"/>
                                <span class="text-muted">Show the create account link below the login button.</span>
                            </div>
                        </setting>

                        <setting id="tbt_loading_setting"
                                 string="Loading Indicator"
                                 company_dependent="1"
                                 help="Enable and customize the global loading indicator.">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Enable</span>
                                    <field name="tbt_loading_enabled" class="w-auto m-0"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Text</span>
                                    <field name="tbt_loading_text" widget="color" class="w-auto m-0"/>
                                    <field name="tbt_loading_text" placeholder="#FFFFFF" class="w-25"/>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted">Style</span>
                                    <field name="tbt_loading_style" class="w-auto m-0"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tbt_login_layout" inherit_id="web.login_layout" priority="10">

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')]" position="before">
        <t t-set="tbt_login_split_enabled" t-value="request.env.company.sudo().tbt_login_split_enabled"/>
        <t t-set="tbt_login_brand_copy" t-value="request.env.company.sudo().tbt_login_brand_copy"/>
        <t t-set="tbt_login_brand_foot" t-value="request.env.company.sudo().tbt_login_brand_foot"/>
        <t t-set="tbt_login_background_image" t-value="request.env.company.sudo().tbt_login_background_image"/>
        <t t-set="tbt_login_background_enabled" t-value="request.env.company.sudo().tbt_login_background_enabled"/>
        <t t-set="tbt_login_background_pattern" t-value="request.env.company.sudo().tbt_login_background_pattern"/>
        <t t-set="tbt_brand_color_rgb" t-value="request.env.company.sudo().tbt_brand_color_rgb or '36,36,36'"/>
        <t t-set="tbt_login_logo_global" t-value="request.env['ir.config_parameter'].sudo().get_param('aura_backend_theme.tbt_login_logo_global')"/>
      </xpath>

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')]" position="before">
        <t t-if="tbt_login_split_enabled">
          <section aria-hidden="true"
                   t-attf-class="tbt-auth-brand #{'tbt-auth-brand--pattern-off' if (tbt_login_background_enabled and tbt_login_background_image and not tbt_login_background_pattern) else ''}"
                   t-attf-style="#{'background-image: linear-gradient(rgba(' + tbt_brand_color_rgb + ', .78), rgba(0, 0, 0, .86)), url(/web/image/res.company/' + str(request.env.company.id) + '/tbt_login_background_image); background-size: cover; background-position: center center;' if (tbt_login_background_enabled and tbt_login_background_image) else ''}">
            <div class="tbt-auth-brand-inner">
              <div class="tbt-auth-brand-mark">
                <img t-if="tbt_login_logo_global"
                     t-att-src="tbt_login_logo_global if str(tbt_login_logo_global).startswith('data:image') else ('data:image/png;base64,%s' % tbt_login_logo_global)"
                     alt="Login logo"/>
                <img t-else=""
                     t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                     alt="Company logo"/>
              </div>
              <h1 class="tbt-auth-brand-title">
                <br/><t t-esc="request.env.company.name"/>!
              </h1>
              <p class="tbt-auth-brand-copy">
                <t t-esc="tbt_login_brand_copy"/>
              </p>
              <p class="tbt-auth-brand-foot">
                &#169; <t t-esc="tbt_login_brand_foot.replace('{company_name}', request.env.company.name)"/>
              </p>
            </div>
          </section>
        </t>
      </xpath>

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')]" position="attributes">
        <attribute name="t-attf-class">container py-5 #{'tbt-auth-shell' if tbt_login_split_enabled else ''}</attribute>
        <attribute name="style"/>
      </xpath>

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' card-body ')]/div[contains(concat(' ', normalize-space(@class), ' '), ' text-center ') and contains(concat(' ', normalize-space(@class), ' '), ' pb-3 ')]" position="before">
        <div class="tbt-login-head mb-4">
          <h2 class="tbt-login-welcome-text">Welcome Back!</h2>
          <p class="tbt-login-subtext" t-if="request.env.company.sudo().tbt_login_show_signup">
            Don't have an account?
            <a href="/web/signup">Create a new account now</a>, it's free and quick.
          </p>
        </div>
      </xpath>

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' card-body ')]/div[contains(concat(' ', normalize-space(@class), ' '), ' text-center ') and contains(concat(' ', normalize-space(@class), ' '), ' pb-3 ')]" position="attributes">
        <attribute name="class" add="tbt-login-stock-logo" separator=" "/>
      </xpath>

    </template>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="aura_backend_theme.ThemeSettingsDialog">
    <Dialog title="'Theme Settings'"
            size="'lg'"
            contentClass="'tbt-tsd-dialog'">

      <!-- ── Body: sidebar + content ──────────────────────────────────────── -->
      <div class="tbt-tsd-body">

        <!-- Left mini-sidebar -->
        <nav class="tbt-tsd-sidebar">
          <div class="tbt-tsd-sidebar-label">Settings</div>
          <t t-foreach="navItems" t-as="item" t-key="item.id">
            <button
              class="tbt-tsd-nav-item"
              t-att-class="{ 'is-active': state.activeSection === item.id }"
              type="button"
              t-on-click="() => this.setSection(item.id)">
              <i t-att-class="item.icon" aria-hidden="true"/>
              <span t-esc="item.label"/>
            </button>
          </t>
        </nav>

        <!-- Right content pane -->
        <div class="tbt-tsd-content">

          <!-- ── Brand section ─────────────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'brand'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Brand</h3>
              <p class="tbt-tsd-section-desc">
                Customise the primary colour and sidebar style for this company.
              </p>
            </div>

            <!-- ── Brand color ─────────────────────────────────────────────── -->
            <div class="tbt-tsd-field">
              <label class="tbt-tsd-field-label">Brand Color</label>
              <p class="tbt-tsd-field-hint">
                Primary accent used across buttons, links and the active sidebar item.
              </p>
              <div class="tbt-tsd-color-row">
                <div class="tbt-tsd-swatch-wrap">
                  <input
                    type="color"
                    class="tbt-tsd-color-picker"
                    t-att-value="state.brandColor"
                    t-on-input="onColorPickerChange"/>
                  <div class="tbt-tsd-swatch-preview"
                       t-att-style="'background:' + state.brandColor"/>
                </div>
                <input
                  type="text"
                  class="tbt-tsd-hex-input o_input"
                  maxlength="7"
                  placeholder="#242424"
                  t-att-value="state.brandColor"
                  t-on-change="onHexInputChange"/>
                <button
                  type="button"
                  class="btn btn-secondary tbt-tsd-reset-btn"
                  t-on-click="resetBrandColor">
                  Reset
                </button>
              </div>
              <div class="tbt-tsd-color-preview">
                <span class="tbt-tsd-preview-chip"
                      t-att-style="'background:' + state.brandColor"/>
                <span class="tbt-tsd-preview-text" t-esc="state.brandColor"/>
              </div>
            </div>

            <div class="tbt-tsd-divider"/>

            <!-- ── Dark sidebar toggle + color ────────────────────────────── -->
            <div class="tbt-tsd-field">
              <!-- Toggle row -->
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">Dark Sidebar</label>
                  <p class="tbt-tsd-field-hint">
                    Switch the left sidebar to a dark palette.
                    Choose a hue below to tint the darkness.
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.darkSidebar }"
                  t-on-click="toggleDarkSidebar"
                  t-att-aria-checked="state.darkSidebar ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>

              <!-- Dark hue picker — visible only when dark mode is on -->
              <div class="tbt-tsd-dark-picker" t-if="state.darkSidebar">
                <div class="tbt-tsd-dark-picker-label">Sidebar tone</div>

                <!-- Preset chips -->
                <div class="tbt-tsd-preset-row">
                  <t t-foreach="presets" t-as="preset" t-key="preset.id">
                    <t t-if="preset.id !== 'custom'">
                      <button
                        type="button"
                        class="tbt-tsd-preset-chip"
                        t-att-class="{ 'is-selected': state.darkPresetId === preset.id }"
                        t-att-title="preset.label"
                        t-att-style="'background:' + preset.preview"
                        t-on-click="() => this.selectDarkPreset(preset)">
                        <span class="tbt-tsd-preset-chip-label" t-esc="preset.label"/>
                        <i t-if="state.darkPresetId === preset.id"
                           class="fa fa-check tbt-tsd-preset-check"/>
                      </button>
                    </t>
                  </t>

                  <!-- Custom chip with colour picker -->
                  <div class="tbt-tsd-preset-chip tbt-tsd-preset-custom"
                       t-att-class="{ 'is-selected': state.darkPresetId === 'custom' }"
                       t-att-title="'Custom'"
                       t-att-style="state.darkPresetId === 'custom' ? 'background:' + state.darkColor : ''">
                    <input
                      type="color"
                      class="tbt-tsd-color-picker tbt-tsd-dark-color-picker"
                      t-att-value="state.darkColor"
                      t-on-input="onDarkColorPickerChange"
                      t-on-click="() => this.selectDarkPreset({ id: 'custom' })"/>
                    <span class="tbt-tsd-preset-chip-label">Custom</span>
                    <i t-if="state.darkPresetId === 'custom'"
                       class="fa fa-check tbt-tsd-preset-check"/>
                  </div>
                </div>

                <!-- Hex input for custom dark color -->
                <div class="tbt-tsd-dark-hex-row" t-if="state.darkPresetId === 'custom'">
                  <input
                    type="text"
                    class="tbt-tsd-hex-input o_input"
                    maxlength="7"
                    placeholder="#1E2433"
                    t-att-value="state.darkColor"
                    t-on-change="onDarkHexInputChange"/>
                  <span class="tbt-tsd-field-hint" style="margin:0">
                    Enter a hex colour — the sidebar will use a deep dark shade of it.
                  </span>
                </div>

                <!-- Live preview bar -->
                <div class="tbt-tsd-dark-preview-bar"
                     t-att-style="'background:' + state.darkColor">
                  <span class="tbt-tsd-dark-preview-text">Sidebar preview</span>
                </div>

              </div><!-- /.tbt-tsd-dark-picker -->
            </div>

          </div><!-- /.tbt-tsd-section -->

          <!-- ── Topbar section ────────────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'topbar'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Top Bar</h3>
              <p class="tbt-tsd-section-desc">
                Configure navigation bar background and text/icon colors.
              </p>
            </div>

            <div class="tbt-tsd-grid-two">
              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Top Bar Background</label>
                  <p class="tbt-tsd-field-hint">Applied to the fixed header at the top of the backend.</p>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input
                        type="color"
                        class="tbt-tsd-color-picker"
                        t-att-value="state.topbarBg"
                        t-on-input="onTopbarBgPickerChange"/>
                      <div class="tbt-tsd-swatch-preview"
                           t-att-style="'background:' + state.topbarBg"/>
                    </div>
                    <input
                      type="text"
                      class="tbt-tsd-hex-input o_input"
                      maxlength="7"
                      placeholder="#ffffff"
                      t-att-value="state.topbarBg"
                      t-on-change="onTopbarBgHexInputChange"/>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Top Bar Text</label>
                  <p class="tbt-tsd-field-hint">Used for top bar labels and icons.</p>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input
                        type="color"
                        class="tbt-tsd-color-picker"
                        t-att-value="state.topbarText"
                        t-on-input="onTopbarTextPickerChange"/>
                      <div class="tbt-tsd-swatch-preview"
                           t-att-style="'background:' + state.topbarText"/>
                    </div>
                    <input
                      type="text"
                      class="tbt-tsd-hex-input o_input"
                      maxlength="7"
                      placeholder="#0c0f0f"
                      t-att-value="state.topbarText"
                      t-on-change="onTopbarTextHexInputChange"/>
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="btn btn-secondary tbt-tsd-reset-btn"
              t-on-click="resetTopbarColors">
              Reset Top Bar Colors
            </button>

          </div><!-- /.tbt-tsd-section -->

          <!-- ── Background section ───────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'backgrounds'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Backgrounds</h3>
              <p class="tbt-tsd-section-desc">
                Control content background and card/form surface colors.
              </p>
            </div>

            <div class="tbt-tsd-grid-two">
              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Content Background</label>
                  <p class="tbt-tsd-field-hint">Base background around forms, lists and kanban pages.</p>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input
                        type="color"
                        class="tbt-tsd-color-picker"
                        t-att-value="state.contentBg"
                        t-on-input="onContentBgPickerChange"/>
                      <div class="tbt-tsd-swatch-preview"
                           t-att-style="'background:' + state.contentBg"/>
                    </div>
                    <input
                      type="text"
                      class="tbt-tsd-hex-input o_input"
                      maxlength="7"
                      placeholder="#f6f6f6"
                      t-att-value="state.contentBg"
                      t-on-change="onContentBgHexInputChange"/>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Card / Form Surface</label>
                  <p class="tbt-tsd-field-hint">Background for form sheets, cards and panel surfaces.</p>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input
                        type="color"
                        class="tbt-tsd-color-picker"
                        t-att-value="state.cardBg"
                        t-on-input="onCardBgPickerChange"/>
                      <div class="tbt-tsd-swatch-preview"
                           t-att-style="'background:' + state.cardBg"/>
                    </div>
                    <input
                      type="text"
                      class="tbt-tsd-hex-input o_input"
                      maxlength="7"
                      placeholder="#ffffff"
                      t-att-value="state.cardBg"
                      t-on-change="onCardBgHexInputChange"/>
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="btn btn-secondary tbt-tsd-reset-btn"
              t-on-click="resetBackgroundColors">
              Reset Background Colors
            </button>



          </div><!-- /.tbt-tsd-section -->

          <!-- ── Dashboard section ─────────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'dashboard'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Dashboard</h3>
              <p class="tbt-tsd-section-desc">
                Set the accent color and background style for dashboard stat card positions 1 to 4.
              </p>
            </div>

            <div class="tbt-tsd-field tbt-tsd-field-panel tbt-tsd-dashboard-style-panel">
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">Gradient Pattern</label>
                  <p class="tbt-tsd-field-hint">
                    Keep the soft circle/gradient texture on stat cards. Turn it off for flat solid color cards.
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.dashboardCardPattern }"
                  t-on-click="toggleDashboardCardPattern"
                  t-att-aria-checked="state.dashboardCardPattern ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>
            </div>

            <div class="tbt-tsd-field">
              <label class="tbt-tsd-field-label">Color Combinations</label>
              <p class="tbt-tsd-field-hint">
                Apply a full four-card palette, then fine-tune individual cards below.
              </p>
              <div class="tbt-tsd-dashboard-preset-grid">
                <t t-foreach="dashboardPresets" t-as="preset" t-key="preset.id">
                  <button
                    type="button"
                    class="tbt-tsd-dashboard-preset"
                    t-att-class="{ 'is-selected': isDashboardPresetSelected(preset) }"
                    t-on-click="() => this.applyDashboardPreset(preset)">
                    <span class="tbt-tsd-dashboard-preset-swatches">
                      <t t-foreach="preset.colors" t-as="color" t-key="color">
                        <span class="tbt-tsd-dashboard-preset-swatch" t-att-style="'background:' + color"/>
                      </t>
                    </span>
                    <span class="tbt-tsd-dashboard-preset-label" t-esc="preset.label"/>
                  </button>
                </t>
              </div>
            </div>

            <div class="tbt-tsd-grid-two">
              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Card 1</label>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input type="color" class="tbt-tsd-color-picker" t-att-value="state.dashboardCard1" t-on-input="(ev) => this.onDashboardCardPickerChange(1, ev)"/>
                      <div class="tbt-tsd-swatch-preview" t-att-style="'background:' + state.dashboardCard1"/>
                    </div>
                    <input type="text" class="tbt-tsd-hex-input o_input" maxlength="7" placeholder="#000000" t-att-value="state.dashboardCard1" t-on-change="(ev) => this.onDashboardCardHexInputChange(1, ev)"/>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Card 2</label>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input type="color" class="tbt-tsd-color-picker" t-att-value="state.dashboardCard2" t-on-input="(ev) => this.onDashboardCardPickerChange(2, ev)"/>
                      <div class="tbt-tsd-swatch-preview" t-att-style="'background:' + state.dashboardCard2"/>
                    </div>
                    <input type="text" class="tbt-tsd-hex-input o_input" maxlength="7" placeholder="#6D6D6D" t-att-value="state.dashboardCard2" t-on-change="(ev) => this.onDashboardCardHexInputChange(2, ev)"/>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Card 3</label>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input type="color" class="tbt-tsd-color-picker" t-att-value="state.dashboardCard3" t-on-input="(ev) => this.onDashboardCardPickerChange(3, ev)"/>
                      <div class="tbt-tsd-swatch-preview" t-att-style="'background:' + state.dashboardCard3"/>
                    </div>
                    <input type="text" class="tbt-tsd-hex-input o_input" maxlength="7" placeholder="#FAA140" t-att-value="state.dashboardCard3" t-on-change="(ev) => this.onDashboardCardHexInputChange(3, ev)"/>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Card 4</label>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input type="color" class="tbt-tsd-color-picker" t-att-value="state.dashboardCard4" t-on-input="(ev) => this.onDashboardCardPickerChange(4, ev)"/>
                      <div class="tbt-tsd-swatch-preview" t-att-style="'background:' + state.dashboardCard4"/>
                    </div>
                    <input type="text" class="tbt-tsd-hex-input o_input" maxlength="7" placeholder="#E9DBCA" t-att-value="state.dashboardCard4" t-on-change="(ev) => this.onDashboardCardHexInputChange(4, ev)"/>
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="btn btn-secondary tbt-tsd-reset-btn"
              t-on-click="resetDashboardCardColors">
              Reset Dashboard Card Colors
            </button>

          </div><!-- /.tbt-tsd-section -->

          <!-- ── Login section ─────────────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'login'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Login</h3>
              <p class="tbt-tsd-section-desc">
                Control the login page split layout and create account link.
              </p>
            </div>

            <div class="tbt-tsd-field">
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">Split Screen</label>
                  <p class="tbt-tsd-field-hint">
                    Show the branded split layout on the login page.
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.loginSplit }"
                  t-on-click="toggleLoginSplit"
                  t-att-aria-checked="state.loginSplit ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>
            </div>

            <div class="tbt-tsd-divider"/>

            <div class="tbt-tsd-field">
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">Create Account Link</label>
                  <p class="tbt-tsd-field-hint">
                    Show the signup link below the login button.
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.loginShowSignup }"
                  t-on-click="toggleLoginShowSignup"
                  t-att-aria-checked="state.loginShowSignup ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>
            </div>

            <div t-if="state.loginSplit">
              <div class="tbt-tsd-grid-two mt-3">
                <div class="tbt-tsd-field-panel">
                  <div class="tbt-tsd-field">
                    <label class="tbt-tsd-field-label">Login Logo (Global)</label>
                    <div class="tbt-tsd-login-image-wrap">
                      <img t-if="loginGlobalLogoUrl"
                           class="tbt-tsd-login-image-preview"
                           t-att-src="loginGlobalLogoUrl"
                           alt="Login logo preview"/>
                      <div t-else="" class="tbt-tsd-empty-note">Falls back to company logo.</div>
                    </div>
                    <div class="tbt-tsd-color-row mt-2">
                      <label class="btn btn-secondary tbt-tsd-reset-btn mb-0">
                        Upload Logo
                        <input type="file"
                               class="d-none"
                               accept="image/*"
                               t-on-change="onLoginGlobalLogoChange"/>
                      </label>
                      <button type="button"
                              class="btn btn-secondary tbt-tsd-reset-btn"
                              t-on-click="clearLoginGlobalLogo"
                              t-att-disabled="!state.loginGlobalLogoHasImage and !state.loginGlobalLogoData">
                        Remove
                      </button>
                    </div>
                  </div>
                </div>

                <div class="tbt-tsd-field-panel">
                  <div class="tbt-tsd-field">
                    <label class="tbt-tsd-field-label">Use Background Image</label>
                    <div class="tbt-tsd-field-row">
                      <p class="tbt-tsd-field-hint mb-0">Enable uploaded image on left panel.</p>
                      <button
                        type="button"
                        class="tbt-tsd-toggle"
                        t-att-class="{ 'is-on': state.loginUseBackgroundImage }"
                        t-on-click="toggleLoginUseBackgroundImage"
                        t-att-aria-checked="state.loginUseBackgroundImage ? 'true' : 'false'"
                        role="switch">
                        <span class="tbt-tsd-toggle-thumb"/>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="tbt-tsd-field-panel" t-if="state.loginUseBackgroundImage">
                  <div class="tbt-tsd-field">
                    <label class="tbt-tsd-field-label">Circular Pattern</label>
                    <div class="tbt-tsd-field-row">
                      <p class="tbt-tsd-field-hint mb-0">Show circular rings over image.</p>
                      <button
                        type="button"
                        class="tbt-tsd-toggle"
                        t-att-class="{ 'is-on': state.loginBackgroundPattern }"
                        t-on-click="toggleLoginBackgroundPattern"
                        t-att-aria-checked="state.loginBackgroundPattern ? 'true' : 'false'"
                        role="switch">
                        <span class="tbt-tsd-toggle-thumb"/>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-grid-two mt-3">
                <div class="tbt-tsd-field-panel">
                  <div class="tbt-tsd-field">
                    <label class="tbt-tsd-field-label">Login Brand Copy</label>
                    <textarea
                      class="tbt-tsd-textarea o_input"
                      rows="4"
                      t-on-input="onLoginBrandCopyInput"><t t-esc="state.loginBrandCopy"/></textarea>
                  </div>
                </div>

                <div class="tbt-tsd-field-panel">
                  <div class="tbt-tsd-field">
                    <label class="tbt-tsd-field-label">Login Footer Text</label>
                    <textarea
                      class="tbt-tsd-textarea o_input"
                      rows="2"
                      t-on-input="onLoginBrandFootInput"><t t-esc="state.loginBrandFoot"/></textarea>
                  </div>
                </div>
              </div>

              <div class="tbt-tsd-field-panel mt-3" t-if="state.loginUseBackgroundImage">
                <div class="tbt-tsd-field" style="margin-bottom:0">
                  <label class="tbt-tsd-field-label">Left Panel Background Image</label>

                  <div class="tbt-tsd-login-image-wrap">
                    <img t-if="loginBackgroundImageUrl"
                         class="tbt-tsd-login-image-preview"
                         t-att-src="loginBackgroundImageUrl"
                         alt="Login background preview"/>
                    <div t-else="" class="tbt-tsd-empty-note">
                      No custom image uploaded.
                    </div>
                  </div>

                  <div class="tbt-tsd-color-row mt-2">
                    <label class="btn btn-secondary tbt-tsd-reset-btn mb-0">
                      Upload Image
                      <input type="file"
                             class="d-none"
                             accept="image/*"
                             t-on-change="onLoginBackgroundImageChange"/>
                    </label>
                    <button type="button"
                            class="btn btn-secondary tbt-tsd-reset-btn"
                            t-on-click="clearLoginBackgroundImage"
                            t-att-disabled="!state.loginBackgroundHasImage and !state.loginBackgroundImageData">
                      Remove Image
                    </button>
                  </div>
                </div>
              </div>

              <button
                type="button"
                class="btn btn-secondary tbt-tsd-reset-btn mt-3"
                t-on-click="resetLoginTexts">
                Reset Login Texts
              </button>
            </div>

          </div><!-- /.tbt-tsd-section -->

          <!-- ── Loading section ──────────────────────────────────────────── -->
          <div class="tbt-tsd-section" t-if="state.activeSection === 'loading'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Loading Indicator</h3>
              <p class="tbt-tsd-section-desc">
                Enable and style the global loader shown during RPC requests.
              </p>
            </div>

            <div class="tbt-tsd-field-panel">
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">Custom Loader</label>
                  <p class="tbt-tsd-field-hint">
                    Toggle your custom themed loading indicator on or off.
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.loadingEnabled }"
                  t-on-click="toggleLoadingEnabled"
                  t-att-aria-checked="state.loadingEnabled ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>
            </div>

            <div class="tbt-tsd-grid-two mt-3" t-if="state.loadingEnabled">
              <div class="tbt-tsd-field-panel">
                <div class="tbt-tsd-field">
                  <label class="tbt-tsd-field-label">Loading Text / Spinner</label>
                  <p class="tbt-tsd-field-hint">Text and spinner color inside the indicator.</p>
                  <div class="tbt-tsd-color-row">
                    <div class="tbt-tsd-swatch-wrap">
                      <input
                        type="color"
                        class="tbt-tsd-color-picker"
                        t-att-value="state.loadingText"
                        t-on-input="onLoadingTextPickerChange"/>
                      <div class="tbt-tsd-swatch-preview"
                           t-att-style="'background:' + state.loadingText"/>
                    </div>
                    <input
                      type="text"
                      class="tbt-tsd-hex-input o_input"
                      maxlength="7"
                      placeholder="#FFFFFF"
                      t-att-value="state.loadingText"
                      t-on-change="onLoadingTextHexInputChange"/>
                  </div>
                </div>
              </div>
            </div>

            <div class="tbt-tsd-field-panel mt-2" t-if="state.loadingEnabled">
              <div class="tbt-tsd-field" style="margin-bottom:0">
                <label class="tbt-tsd-field-label">Loading Style</label>
                <p class="tbt-tsd-field-hint">Pick one of the six loader styles.</p>
                <div class="tbt-tsd-loading-style-grid">
                  <t t-foreach="loadingStyles" t-as="style" t-key="style.id">
                    <button
                      type="button"
                      class="tbt-tsd-loading-style-tile"
                      t-att-class="{ 'is-selected': state.loadingStyle === style.id }"
                      t-on-click="() => this.onLoadingStyleChange({ target: { value: style.id } })">
                      <span class="tbt-tsd-loading-style-preview"
                            t-att-class="'tbt-tsd-loading-style-preview-' + style.id"/>
                      <span class="tbt-tsd-loading-style-label" t-esc="style.label"/>
                    </button>
                  </t>
                </div>
              </div>
            </div>

            <div class="tbt-tsd-loading-preview" t-if="state.loadingEnabled"
        t-att-style="'background: var(--tbt-brand-color, #242424); color:' + state.loadingText">
              <span class="tbt-tsd-loading-dot" t-att-style="'border-color:' + state.loadingText + '55;border-top-color:' + state.loadingText"/>
              <span>Loading</span>
            </div>

            <button
              type="button"
              class="btn btn-secondary tbt-tsd-reset-btn mt-3"
              t-on-click="resetLoadingColors">
              Reset Loading Settings
            </button>

          </div><!-- /.tbt-tsd-section -->

          <!--
          ── Accessibility section (temporarily disabled) ────────────────────
          <div class="tbt-tsd-section" t-if="state.activeSection === 'accessibility'">

            <div class="tbt-tsd-section-header">
              <h3 class="tbt-tsd-section-title">Accessibility</h3>
              <p class="tbt-tsd-section-desc">
                Improve field visibility for users who prefer stronger contrast.
              </p>
            </div>

            <div class="tbt-tsd-field-panel">
              <div class="tbt-tsd-field-row">
                <div>
                  <label class="tbt-tsd-field-label">High Contrast</label>
                  <p class="tbt-tsd-field-hint">
                    Restore clear field borders in forms (classic style).
                  </p>
                </div>
                <button
                  type="button"
                  class="tbt-tsd-toggle"
                  t-att-class="{ 'is-on': state.highContrast }"
                  t-on-click="toggleHighContrast"
                  t-att-aria-checked="state.highContrast ? 'true' : 'false'"
                  role="switch">
                  <span class="tbt-tsd-toggle-thumb"/>
                </button>
              </div>
            </div>

          </div>
          -->

        </div><!-- /.tbt-tsd-content -->
      </div><!-- /.tbt-tsd-body -->

      <!-- ── Footer ────────────────────────────────────────────────────────── -->
      <t t-set-slot="footer">
        <button type="button" class="btn btn-secondary" t-on-click="props.close">
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-primary tbt-tsd-save-btn"
          t-att-disabled="state.saving"
          t-on-click="save">
          <i t-if="state.saving" class="fa fa-circle-o-notch fa-spin me-1"/>
          <t t-if="state.saving">Saving…</t>
          <t t-else="">Save Changes</t>
        </button>
      </t>

    </Dialog>
  </t>

</templates>

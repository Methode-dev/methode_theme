<t t-name="aura_backend_theme.MRPProductionWidget">
    <div class="hd-card aw-card">
        <div class="hd-card-header">
            <span class="hd-card-title">
                <i class="fa fa-industry"/> Production Orders
                <t t-if="props.count > 0">
                    <span class="aw-header-count" t-esc="props.count"/>
                </t>
            </span>
            <button class="hd-card-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/web#model=mrp.production&amp;view_type=list')">View all →</button>
        </div>
        <div class="hd-card-body">
            <t t-if="!props.items.length">
                <div class="hd-empty-cta">
                    <i class="fa fa-industry hd-empty-icon"/>
                    <p>No production orders are currently active.</p>
                </div>
            </t>
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <div class="aw-row" t-on-click="() => this.navigate(item.action or item.record_url)">
                    <div class="aw-row-icon aw-icon-purple">
                        <i class="fa fa-cogs"/>
                    </div>
                    <div class="aw-row-body">
                        <span class="aw-row-name" t-esc="item.name"/>
                        <span class="aw-row-sub">
                            <t t-esc="item.product_name"/>
                            <t t-if="item.origin"> · <t t-esc="item.origin"/></t>
                        </span>
                    </div>
                    <div class="aw-row-right">
                        <span class="aw-row-amount">
                            <t t-esc="item.quantity.toFixed(0)"/> <t t-esc="item.unit"/>
                        </span>
                        <span t-attf-class="#{stateClass(item.state)}" t-esc="item.state"/>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

<!-- ── Accounting: Aged Receivables ─────────────────────────────────────── -->
<t t-name="aura_backend_theme.AccountAgedReceivablesWidget">
    <div class="hd-card aw-card">
        <div class="hd-card-header">
            <span class="hd-card-title">
                <i class="fa fa-file-invoice-dollar"/> Aged Receivables
                <t t-if="props.count > 0">
                    <span class="aw-header-count aw-count-alert" t-esc="props.count"/>
                </t>
            </span>
            <button class="hd-card-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/web#model=account.move&amp;view_type=list')">View all →</button>
        </div>
        <div class="hd-card-body">
            <div class="aw-summary-grid">
                <t t-foreach="props.buckets" t-as="bucket" t-key="bucket.key">
                    <div t-attf-class="aw-summary-card #{bucketClass(bucket.key)}">
                        <span class="aw-summary-label" t-esc="bucket.label"/>
                        <span class="aw-summary-value">
                            <t t-esc="props.currencySymbol"/>
                            <t t-esc="bucket.amount.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                        </span>
                        <span class="aw-summary-meta" t-esc="bucket.count + ' invoices'"/>
                    </div>
                </t>
            </div>

            <div class="aw-subsection-title">Top open invoices</div>
            <t t-if="!props.items.length">
                <div class="hd-empty-cta">
                    <i class="fa fa-file-invoice hd-empty-icon"/>
                    <p>No overdue customer invoices were found.</p>
                </div>
            </t>
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <div class="aw-row" t-on-click="() => this.navigate(item.action or item.record_url)">
                    <div class="aw-row-icon aw-icon-red">
                        <i class="fa fa-user-tie"/>
                    </div>
                    <div class="aw-row-body">
                        <span class="aw-row-name" t-esc="item.name"/>
                        <span class="aw-row-sub" t-esc="item.partner_name"/>
                    </div>
                    <div class="aw-row-right">
                        <span class="aw-row-amount">
                            <t t-esc="item.currency_symbol"/>
                            <t t-esc="item.amount_residual.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                        </span>
                        <span class="aw-row-meta"><t t-esc="item.age_days"/>d old</span>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

<!-- ── Accounting: Cash Flow Summary ─────────────────────────────────────── -->
<t t-name="aura_backend_theme.AccountCashflowWidget">
    <div class="hd-card aw-card aw-cashflow-widget">
        <div class="hd-card-header">
            <span class="hd-card-title">
                <i class="fa fa-sack-dollar"/> Cash Flow Summary
            </span>
            <button class="hd-card-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/web#model=account.move&amp;view_type=list')">View all →</button>
        </div>
        <div class="hd-card-body">
            <div class="aw-cashflow-summary">
                <div class="aw-cashflow-net aw-summary-card--neutral">
                    <span class="aw-summary-label">Projected net</span>
                    <span class="aw-cashflow-net-value">
                        <t t-esc="props.currencySymbol"/>
                        <t t-esc="props.net.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                    </span>
                    <span class="aw-summary-meta">Expected cash position after the next 30 days</span>
                </div>
                <div class="aw-cashflow-metrics">
                <div class="aw-summary-card aw-summary-card--positive">
                    <span class="aw-summary-label">Bank balance</span>
                    <span class="aw-summary-value">
                        <t t-esc="props.currencySymbol"/>
                        <t t-esc="props.bankBalance.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                    </span>
                </div>
                <div class="aw-summary-card aw-summary-card--positive">
                    <span class="aw-summary-label">Expected in</span>
                    <span class="aw-summary-value">
                        <t t-esc="props.currencySymbol"/>
                        <t t-esc="props.expectedIn.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                    </span>
                </div>
                <div class="aw-summary-card aw-summary-card--warning">
                    <span class="aw-summary-label">Expected out</span>
                    <span class="aw-summary-value">
                        <t t-esc="props.currencySymbol"/>
                        <t t-esc="props.expectedOut.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                    </span>
                </div>
                </div>
            </div>

            <div class="aw-subsection-title">Next 30 days</div>
            <t t-if="!props.items.length">
                <div class="hd-empty-cta">
                    <i class="fa fa-chart-line hd-empty-icon"/>
                    <p>No incoming or outgoing invoices are due in the next 30 days.</p>
                </div>
            </t>
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <div class="aw-row aw-cashflow-row" t-on-click="() => this.navigate(item.action or item.record_url)">
                    <div t-attf-class="aw-row-icon #{item.direction === 'in' ? 'aw-icon-green' : 'aw-icon-red'}">
                        <i t-attf-class="fa #{item.direction === 'in' ? 'fa-arrow-down' : 'fa-arrow-up'}"/>
                    </div>
                    <div class="aw-row-body">
                        <span class="aw-row-name" t-esc="item.name"/>
                        <span class="aw-row-sub" t-esc="item.partner_name"/>
                    </div>
                    <div class="aw-row-right">
                        <span class="aw-row-amount">
                            <t t-esc="item.currency_symbol"/>
                            <t t-esc="item.amount.toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0})"/>
                        </span>
                        <span class="aw-row-meta" t-esc="item.due_date"/>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

</templates>

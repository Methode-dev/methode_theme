<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<!-- ── Inventory: Products to Reorder ─────────────────────────────────────── -->
<t t-name="aura_backend_theme.InventoryReorderWidget">
    <div class="hd-card aw-card">
        <div class="hd-card-header">
            <span class="hd-card-title">
                <i class="fa fa-boxes"/> Products to Reorder
                <t t-if="props.count > 0">
                    <span class="aw-header-count aw-count-alert" t-esc="props.count"/>
                </t>
            </span>
            <button class="hd-card-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/odoo/inventory/reordering-rules')">View all →</button>
        </div>
        <div class="hd-card-body">
            <t t-if="!props.items.length">
                <div class="hd-empty-cta">
                    <i class="fa fa-check-circle hd-empty-icon"/>
                    <p>All stock levels are healthy.</p>
                </div>
            </t>
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <div class="aw-row" t-on-click="() => this.navigate(item.action or item.record_url)">
                    <div class="aw-row-icon aw-icon-orange">
                        <i class="fa fa-cube"/>
                    </div>
                    <div class="aw-row-body">
                        <span class="aw-row-name" t-esc="item.product_name"/>
                        <span class="aw-row-sub" t-esc="item.warehouse"/>
                    </div>
                    <div class="aw-row-right">
                        <span t-attf-class="#{stockClass(item.qty_on_hand)}">
                            <t t-esc="item.qty_on_hand.toFixed(0)"/> / <t t-esc="item.product_min_qty.toFixed(0)"/>
                            <t t-esc="item.uom"/>
                        </span>
                        <button class="aw-action-btn" t-on-click.stop="() => this.navigate('/odoo/purchase/new')">
                            Order
                        </button>
                    </div>
                </div>
            </t>
        </div>
        <t t-if="props.count > props.items.length">
            <div class="hd-card-footer">
                <button class="hd-footer-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/odoo/inventory/reordering-rules')">
                    + <t t-esc="props.count - props.items.length"/> more products need reordering
                </button>
            </div>
        </t>
    </div>
</t>

<!-- ── General: Activity Trend (mini chart) ─────────────────────────────── -->
<t t-name="aura_backend_theme.ActivityTrendWidget">
    <div class="hd-card aw-card aw-graph-widget">
        <div class="hd-card-header">
            <span class="hd-card-title">
                <i class="fa fa-chart-pie"/> My Activity Trend
                <t t-if="props.total > 0">
                    <span class="aw-header-count" t-esc="props.total"/>
                </t>
            </span>
            <button class="hd-card-link hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/odoo/todos')">View all →</button>
        </div>
        <div class="hd-card-body">
            <t t-if="!props.points.length || props.total === 0">
                <div class="hd-empty-cta">
                    <i class="fa fa-chart-pie hd-empty-icon"/>
                    <p>No activities yet.</p>
                </div>
            </t>
            <t t-else="">
                <div class="aw-graph-kpi">
                    <div class="aw-graph-kpi-value" t-esc="props.total"/>
                    <div class="aw-graph-kpi-label">total activities</div>
                </div>
                <div class="aw-chart-wrap aw-chart-wrap--activity">
                    <t t-foreach="props.points" t-as="p" t-key="p.key">
                        <div class="aw-chart-col">
                            <div class="aw-chart-plot">
                                <div t-attf-class="#{pointClass(p.color)}" t-att-style="'height:' + barHeight(p.value)"/>
                            </div>
                            <div class="aw-chart-value" t-esc="p.value"/>
                            <div class="aw-chart-label" t-esc="p.label"/>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </div>
</t>

<!-- ── Sales: Monthly Trend (mini chart) ─────────────────────────────────── -->
<t t-name="aura_backend_theme.SalesTrendWidget">
    <div class="hd-card aw-card aw-graph-widget">
        <div class="hd-card-header">
            <span class="hd-card-title"><i class="fa fa-chart-column"/> Sales Trend (6 Months)</span>
            <div class="hd-topbar-right">
                <button class="hd-card-action-btn" t-on-click="() => this.navigate(props.createAction or '/odoo/sales/new')">
                    <i class="fa fa-plus"/> New
                </button>
                <button class="hd-card-link hd-card-link--ml hd-link-btn" t-on-click="() => this.navigate(props.viewAction or '/odoo/sales')">All →</button>
            </div>
        </div>
        <div class="hd-card-body">
            <t t-if="!props.points.length">
                <div class="hd-empty-cta">
                    <i class="fa fa-chart-column hd-empty-icon"/>
                    <p>No sales data available yet.</p>
                </div>
            </t>
            <t t-else="">
                <div class="aw-graph-kpi">
                    <div class="aw-graph-kpi-value">
                        <t t-esc="props.currencySymbol"/>
                        <t t-esc="Math.round(props.totalAmount || 0).toLocaleString()"/>
                    </div>
                    <div class="aw-graph-kpi-label">6-month total • confirmed + done</div>
                </div>
                <div class="aw-chart-wrap aw-chart-wrap--sales">
                    <t t-foreach="props.points" t-as="p" t-key="p.key">
                        <div class="aw-chart-col">
                            <div class="aw-chart-plot">
                                <div class="aw-chart-bar aw-chart-bar--blue" t-att-style="'height:' + barHeight(p.amount)"/>
                            </div>
                            <div class="aw-chart-value" t-esc="Math.round(p.amount || 0).toLocaleString()"/>
                            <div class="aw-chart-label" t-esc="p.label"/>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </div>
</t>


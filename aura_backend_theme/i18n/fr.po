# ── Model: res.company — help texts ─────────────────────────────────────────

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Primary brand color for the backend theme, in #RRGGBB format."
msgstr "Couleur principale de marque du thème backend, au format #RRGGBB."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Use a darker sidebar palette for better contrast in the navigation area."
msgstr ""
"Utilise une palette de couleurs plus sombre pour la barre latérale afin "
"d'améliorer le contraste dans la zone de navigation."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid ""
"Base hue for the dark sidebar. The theme derives a deep dark shade from this "
"colour. Default #1E2433 gives the classic dark navy look."
msgstr ""
"Teinte de base de la barre latérale foncée. Le thème en dérive une nuance "
"sombre profonde. Par défaut, #1E2433 donne l'aspect bleu marine foncé "
"classique."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Background colour of the top navigation bar."
msgstr "Couleur d'arrière-plan de la barre de navigation supérieure."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Text and icon colour used inside the top bar."
msgstr "Couleur du texte et des icônes dans la barre supérieure."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Background of the main content area (list, kanban, form views)."
msgstr "Arrière-plan de la zone de contenu principale (vues liste, kanban, formulaire)."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Background of form sheets, cards and panel surfaces."
msgstr "Arrière-plan des feuilles de formulaire, des fiches et des panneaux."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Accent background color for the first dashboard stat card."
msgstr "Couleur d'accentuation pour la première carte statistique du tableau de bord."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Accent background color for the second dashboard stat card."
msgstr "Couleur d'accentuation pour la deuxième carte statistique du tableau de bord."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Accent background color for the third dashboard stat card."
msgstr "Couleur d'accentuation pour la troisième carte statistique du tableau de bord."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Accent background color for the fourth dashboard stat card."
msgstr "Couleur d'accentuation pour la quatrième carte statistique du tableau de bord."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid ""
"Use flat solid backgrounds on dashboard stat cards instead of the soft "
"gradient/circle pattern."
msgstr ""
"Utilise des fonds plats et unis pour les cartes statistiques du tableau de "
"bord au lieu du motif dégradé."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Show the branded split-screen layout on the login page."
msgstr "Affiche la mise en page fractionnée brandée sur la page de connexion."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Show the create account link on the login page."
msgstr "Affiche le lien de création de compte sur la page de connexion."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Descriptive text shown in the branded login panel."
msgstr "Texte descriptif affiché dans le panneau de connexion brandé."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid ""
"Footer text shown in the branded login panel. Use {company_name} as a "
"placeholder for the active company name."
msgstr ""
"Texte de pied de page dans le panneau de connexion brandé. Utilisez "
"{company_name} comme espace réservé pour le nom de la société active."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid ""
"Optional background image for the left branded panel of the split login page."
msgstr ""
"Image d'arrière-plan optionnelle pour le panneau gauche brandé de la page "
"de connexion fractionnée."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Enable the uploaded image on the left split panel."
msgstr "Active l'image téléchargée sur le panneau gauche de l'écran fractionné."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Show circular ring patterns on the left split panel when image is used."
msgstr "Affiche des motifs circulaires sur le panneau gauche lorsqu'une image est utilisée."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Enable custom theme styling for the global loading indicator."
msgstr "Active le style personnalisé du thème pour l'indicateur de chargement global."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Text and spinner colour used by the loading indicator."
msgstr "Couleur du texte et du spinner de l'indicateur de chargement."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Visual style of the loading spinner."
msgstr "Style visuel du spinner de chargement."

#. module: aura_backend_theme
#: code:addons/aura_backend_theme/__manifest__.py:0
msgid "Enable stronger contrast in form fields by restoring visible borders."
msgstr "Active un contraste plus fort dans les champs de formulaire en restaurant les bordures visibles."


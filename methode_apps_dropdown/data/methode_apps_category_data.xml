<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      noupdate="1" on purpose: these records exist to be edited by the customer's
      admin, which is the whole point of module_category_ids being a real m2m
      rather than a Python dict. Without it, every `-u methode_apps_dropdown`
      would silently revert their taxonomy.

      Consequence: edits to EXISTING records shipped in a later version need a
      migration script. Adding a NEW record works as-is, because a noupdate
      record whose xmlid does not exist yet is still created on upgrade.

      Only xmlids declared in base/data/ir_module_category_data.xml are ref'd
      here. The runtime-created ones are linked defensively from
      methode_apps_category.py::DYNAMIC_MODULE_CATEGORY_MAPPING, because `ref=`
      raises when the record is absent.
    -->
    <data noupdate="1">

        <record id="apps_category_sales" model="methode.apps.category">
            <field name="name">Sales &amp; Finance</field>
            <field name="code">sales</field>
            <field name="sequence">10</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_sales'),
                ref('base.module_category_accounting'),
                ref('base.module_category_accounting_accounting'),
                ref('base.module_category_shipping_connectors'),
            ])]"/>
        </record>

        <record id="apps_category_operations" model="methode.apps.category">
            <field name="name">Operations</field>
            <field name="code">operations</field>
            <field name="sequence">20</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_supply_chain'),
                ref('base.module_category_services'),
                ref('base.module_category_services_helpdesk'),
            ])]"/>
        </record>

        <record id="apps_category_hr" model="methode.apps.category">
            <field name="name">Human Resources</field>
            <field name="code">hr</field>
            <field name="sequence">30</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_human_resources'),
                ref('base.module_category_human_resources_appraisals'),
                ref('base.module_category_human_resources_referrals'),
                ref('base.module_category_payroll_localization'),
            ])]"/>
        </record>

        <record id="apps_category_marketing" model="methode.apps.category">
            <field name="name">Marketing &amp; Website</field>
            <field name="code">marketing</field>
            <field name="sequence">40</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_marketing'),
                ref('base.module_category_website'),
            ])]"/>
        </record>

        <record id="apps_category_productivity" model="methode.apps.category">
            <field name="name">Productivity</field>
            <field name="code">productivity</field>
            <field name="sequence">50</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_productivity'),
                ref('base.module_category_sales_sign'),
            ])]"/>
        </record>

        <record id="apps_category_admin" model="methode.apps.category">
            <field name="name">Administration</field>
            <field name="code">admin</field>
            <field name="sequence">90</field>
            <field name="module_category_ids" eval="[Command.set([
                ref('base.module_category_administration'),
                ref('base.module_category_hidden'),
                ref('base.module_category_customizations'),
                ref('base.module_category_theme'),
                ref('base.module_category_esg'),
                ref('base.module_category_extra'),
            ])]"/>
        </record>

        <!-- Fallback. Guarded against deletion by _unlink_except_fallback. -->
        <record id="apps_category_other" model="methode.apps.category">
            <field name="name">Other</field>
            <field name="code">other</field>
            <field name="sequence">99</field>
        </record>

    </data>
</odoo>

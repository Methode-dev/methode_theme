<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Set the override from the app itself. Hidden on non-root menus, where the
         field is meaningless. -->
    <record id="view_ir_ui_menu_form_apps_category" model="ir.ui.view">
        <field name="name">ir.ui.menu.form.apps.category</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">
            <field name="group_ids" position="after">
                <field name="methode_app_category_id" invisible="parent_id"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <!-- Bulk triage screen: every app in one editable list.
         Deliberately NOT a column on base.edit_menu, which renders every menu in
         the system and where the field is meaningless on ~95% of rows. -->
    <record id="view_methode_app_menu_list" model="ir.ui.view">
        <field name="name">ir.ui.menu.list.apps.category</field>
        <field name="model">ir.ui.menu</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="methode_app_category_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="action_methode_app_menu" model="ir.actions.act_window">
        <field name="name">Apps &amp; Categories</field>
        <field name="res_model">ir.ui.menu</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_methode_app_menu_list"/>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'ir.ui.menu.full_list': True}</field>
        <field name="help" type="html">
            <p>Assign apps to a launcher category by hand. Leaving the field empty falls back to the automatic rules: the module's manifest key, then its Odoo category.</p>
        </field>
    </record>

    <menuitem id="menu_methode_app_menu"
              name="Apps &amp; Categories"
              parent="base.next_id_2"
              action="action_methode_app_menu"
              groups="base.group_system"
              sequence="21"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_methode_apps_category_list" model="ir.ui.view">
        <field name="name">methode.apps.category.list</field>
        <field name="model">methode.apps.category</field>
        <field name="arch" type="xml">
            <!-- editable: the common edit is dragging one Odoo category tag from
                 one bucket to another, which should not cost a form round trip. -->
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <!-- no_create: ir.module.category rows are owned by Odoo's manifest
                     machinery. One created by hand here would have no xmlid and
                     create_categories would later duplicate it. -->
                <field name="module_category_ids" widget="many2many_tags"
                       options="{'no_create': True}"/>
                <field name="app_count" string="Apps"/>
            </list>
        </field>
    </record>

    <record id="view_methode_apps_category_form" model="ir.ui.view">
        <field name="name">methode.apps.category.form</field>
        <field name="model">methode.apps.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_manifests" type="object"
                            class="btn-secondary" string="Resync Manifests"
                            help="Re-read the 'apps_dropdown_category' manifest key of every module. A manifest edited on disk only becomes visible after the Odoo service restarts, because parsed manifests are cached in-process."/>
                    <button name="action_restore_default_mapping" type="object"
                            class="btn-secondary" string="Restore Default Mapping"
                            help="Re-link the Odoo categories shipped by default. Additive: your own links are kept."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales &amp; Finance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. sales"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="app_count"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Odoo Categories" name="module_categories">
                            <p class="text-muted">Apps whose module belongs to one of these Odoo categories land in this business category. Resolution walks up the parent chain, so mapping a parent covers all of its children.</p>
                            <field name="module_category_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Manual Overrides" name="overrides">
                            <p class="text-muted">Apps forced into this category regardless of their module. Takes precedence over everything else.</p>
                            <!-- full_list mirrors base.grant_menu_access; without it
                                 the o2m is filtered by menu visibility. -->
                            <field name="menu_ids" context="{'ir.ui.menu.full_list': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="complete_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_methode_apps_category" model="ir.actions.act_window">
        <field name="name">Apps Launcher Categories</field>
        <field name="res_model">methode.apps.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a business category</p>
            <p>Categories group the tiles of the Apps launcher. Map each one to the Odoo categories that should feed it, or force individual apps in from the Manual Overrides tab.</p>
        </field>
    </record>

    <menuitem id="menu_methode_apps_category"
              name="Apps Launcher Categories"
              parent="base.next_id_2"
              action="action_methode_apps_category"
              groups="base.group_system"
              sequence="20"/>

</odoo>

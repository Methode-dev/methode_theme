<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!--
    aria-hidden on the chip: it is decoration in both of its call sites. The
    launcher tile carries the accessible name on its own aria-label, and the
    sidebar row prints the app name right next to it - announcing the icon too
    would just repeat it.
  -->
  <t t-name="methode_apps_dropdown.AppIcon">
    <span class="o_mad_app_icon" t-att-data-app-category="categoryCode" aria-hidden="true">
      <!--
        The stroke attributes live on the <svg>, never on the paths: one weight
        for the whole set is the rule the set is built on, and putting it in one
        place is what keeps a new glyph from quietly breaking it.
        `stroke="currentColor"` so the glyph inherits the chip's ink colour.
      -->
      <svg t-if="paths.length" class="o_mad_app_glyph" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="1.75"
           stroke-linecap="round" stroke-linejoin="round">
        <path t-foreach="paths" t-as="path" t-key="path_index" t-att-d="path"/>
      </svg>
      <!-- No glyph for this app: its initial, in the same frame and tint. -->
      <span t-else="" class="o_mad_app_monogram" t-esc="monogram"/>
    </span>
  </t>

</templates>

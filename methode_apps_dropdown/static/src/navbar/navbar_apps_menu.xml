<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!--
    HOOK - a single `expr="."` replace.

    Template inheritance is resolved client-side and lazily
    (web/static/src/core/templates.js::_getTemplate). A non-matching xpath throws
    from core/template_inheritance.js, and because this template is reached from
    web.NavBar, that means a blank backend rather than a build error.

    `expr="."` is the only operation that structurally cannot fail: getNode does
    doc.evaluate(".", root), which always returns root, and replace() handles the
    no-parentElement case by promoting our first element child and copying t-name
    across. Worst case is "last writer wins".

    Two things keep the upstream-drift cost near zero:
      1. the this.ui.isSmall and isScopedApp branches are re-emitted VERBATIM,
         including the t-call to web.NavBar.AppsMenu.Sidebar, so mobile stays
         100% stock and keeps receiving upstream fixes;
      2. the stock skeleton is preserved -
             div.o_navbar_apps_menu > Dropdown > button[data-hotkey=h]
                                               + t[t-set-slot=content]
         so third-party xpaths targeting it still match.

    SOURCE OF TRUTH: web/static/src/webclient/navbar/navbar.xml, t-name="web.NavBar.AppsMenu".
    Re-diff this block on every Odoo minor upgrade.
  -->
  <t t-name="methode_apps_dropdown.NavBar.AppsMenu"
     t-inherit="web.NavBar.AppsMenu"
     t-inherit-mode="extension">
    <xpath expr="." position="replace">
      <t>
        <!-- ===== small screens: untouched stock ===== -->
        <t t-if="this.ui.isSmall">
          <a href="/odoo" class="o_menu_toggle border-0"
             t-att-class="{'hasImage': currentApp?.webIconData}"
             accesskey="h" t-ref="menuApps" t-on-click.prevent="_openAppMenuSidebar">
            <t t-call="web.NavBar.AppsMenu.Sidebar"/>
          </a>
        </t>

        <!-- ===== desktop: tiled launcher ===== -->
        <t t-else="">
          <div t-if="!isScopedApp" class="o_navbar_apps_menu">
            <Dropdown
              menuClass="'o_mad_launcher'"
              bottomSheet="false"
              navigationOptions="appsLauncherNavigation">
              <button data-hotkey="h" title="Home Menu">
                <!-- A hamburger, not oi-apps: this opens the whole menu, and the
                     tiled grid is what the panel shows, not what the button is. -->
                <i class="fa fa-bars"/>
              </button>
              <t t-set-slot="content">
                <!-- getMenuItemHref is passed down rather than re-implemented so
                     tiles produce the exact same URL as the app brand and the
                     breadcrumbs, and survive a change to the URL scheme. -->
                <AppsLauncher apps="apps" getMenuItemHref.bind="getMenuItemHref"/>
              </t>
            </Dropdown>
          </div>
          <div t-else="" class="mx-2"/>
        </t>
      </t>
    </xpath>
  </t>

  <!--
    HOOK - a single `expr="."` replace, same rationale as the block above.

    Stock mobile sidebar toggles between "current app nav" and "full app
    list" behind an "All Apps" button that sits ABOVE the current-app nav.
    We instead put both behind a tab strip next to the module title -
    [ Current app | All applications ] - so apps with long navigation (e.g.
    Sales) don't force a scroll-to-the-bottom to reach the app switcher.
    `state.isAllAppsMenuOpened` (already on core NavBar's state) is reused
    as the tab selector instead of a show/hide toggle. On the homepage
    itself there's no app-specific nav to tab against, so we skip the tabs
    entirely and just show the app list (matches AppList below).

    SOURCE OF TRUTH: web/static/src/webclient/navbar/navbar.xml, t-name="web.NavBar.AppsMenu.Sidebar".
    Re-diff this block on every Odoo minor upgrade.
  -->
  <t t-name="methode_apps_dropdown.NavBar.AppsMenu.Sidebar"
     t-inherit="web.NavBar.AppsMenu.Sidebar"
     t-inherit-mode="extension">
    <xpath expr="." position="replace">
      <t>
        <i class="fa fa-bars" aria-hidden="true"/>
        <t t-portal="'body'">
          <Transition name="'o-app-menu-sidebar'" visible="state.isAppMenuSidebarOpened" leaveDuration="200" t-slot-scope="transition">
            <div class="o_app_menu_sidebar position-fixed top-0 bottom-0 end-100 d-flex flex-column flex-nowrap" t-att-class="transition.className" t-on-touchstart.stop="_onSwipeStart" t-on-touchend.stop="_onSwipeEnd">
              <div class="o_sidebar_topbar d-flex align-items-center justify-content-end flex-shrink-0 py-0 fs-4">
                  <button class="o_sidebar_close oi oi-close btn d-flex align-items-center h-100 bg-transparent border-0 fs-2 text-reset" aria-label="Close menu" title="Close menu" t-on-click.stop="_closeAppMenuSidebar"/>
              </div>
              <nav class="o_burger_menu_content flex-grow-1 flex-shrink-1 overflow-auto o_burger_menu_app">
                    <t t-if="currentApp and !isHomepageApp">
                      <div class="o_mad_sidebar_tabs d-flex align-items-center m-3 mb-0">
                        <button type="button" class="o_mad_sidebar_tab d-flex align-items-center"
                                t-att-class="{'is-active': !state.isAllAppsMenuOpened}"
                                t-on-click="() => state.isAllAppsMenuOpened = false">
                          <img style="height: 2em;" t-if="currentApp.webIconData" class="o_app_icon me-2" t-attf-src="{{currentApp.webIconData}}"/>
                          <span class="fs-4 fw-bolder"><t t-esc="currentApp.name"/></span>
                        </button>
                        <button type="button" class="o_mad_sidebar_tab"
                                t-att-class="{'is-active': state.isAllAppsMenuOpened}"
                                t-on-click="() => state.isAllAppsMenuOpened = true">
                          <span class="fs-4 fw-bolder">All applications</span>
                        </button>
                      </div>

                      <ul class="list-unstyled py-2 ps-0 mb-0" t-if="!state.isAllAppsMenuOpened">
                        <t t-foreach="currentAppSections" t-as="subMenu" t-key="subMenu_index">
                          <t t-call="web.SectionMenu">
                              <t t-set="section" t-value="subMenu" />
                          </t>
                        </t>
                      </ul>
                      <t t-else="">
                        <t t-call="methode_apps_dropdown.NavBar.AppsMenu.Sidebar.AppList"/>
                      </t>
                    </t>
                    <t t-else="">
                      <t t-call="methode_apps_dropdown.NavBar.AppsMenu.Sidebar.AppList"/>
                    </t>
              </nav>
            </div>
          </Transition>
          <div t-if="state.isAppMenuSidebarOpened" class="modal-backdrop show d-block d-md-none" t-on-click.stop="_closeAppMenuSidebar" t-on-touchstart.stop="_onSwipeStart" t-on-touchend.stop="_onSwipeEnd" />
        </t>
      </t>
    </xpath>
  </t>

  <!--
    Shared by both branches above: t-call preserves the caller's rendering
    scope (this, apps, menuService, ...), same as core's own t-call="web.SectionMenu",
    so this needs no props of its own.
  -->
  <t t-name="methode_apps_dropdown.NavBar.AppsMenu.Sidebar.AppList">
    <ul class="list-unstyled py-2 ps-0 mb-0">
      <t t-foreach="apps" t-as="app" t-key="app_index">
        <li t-att-data-menu-xmlid="app.xmlid" class="o_app fw-bolder py-2" t-att-class="{'bg-primary-subtle': menuService.getCurrentApp() === app}" t-on-click="() => {this.onNavBarDropdownItemSelection(app); this._closeAppMenuSidebar();}">
          <div class="d-flex align-items-center">
            <img style="height: 3em;" t-if="app.webIconData" class="o_app_icon me-2" t-attf-src="{{app.webIconData}}"/>
            <t t-esc="app.name"/>
          </div>
        </li>
      </t>
    </ul>
  </t>

</templates>

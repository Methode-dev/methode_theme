<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="methode_apps_dropdown.AppsLauncher">
    <!--
      role="none" on the wrapper: the popover root already carries role="menu"
      (Dropdown passes it to usePopover). A bare div between a menu and its
      menuitems would break the ARIA owning relationship.

      The scroller lives HERE and not on the popover itself. The positioning
      engine (web/static/src/core/position/utils.js) writes an inline
      `max-height: min(<existing>, <available>)` on the popover on every
      reposition and never clears it, so a CSS max-height there would make the
      panel shrink monotonically while open.
    -->
    <div class="o_mad_panel" role="none">
      <t t-foreach="sections" t-as="section" t-key="section.id">
        <div class="o_mad_section" role="group" t-att-aria-label="section.name">
          <div class="o_mad_section_title" role="presentation" t-esc="section.name"/>

          <div class="o_mad_grid" role="none">
            <DropdownItem
              t-foreach="section.tiles" t-as="tile" t-key="tile.id"
              class="{
                'o_app': true,
                'o_mad_tile': true,
                'o_mad_tile_current': tile.isCurrent,
              }"
              onSelected="() => this.onAppSelected(tile)"
              attrs="{
                href: tile.href,
                'data-menu-xmlid': tile.xmlid,
                'data-section': tile.id,
                'aria-label': tileAriaLabel(tile),
                title: tile.name,
              }">

              <!-- Icon: image, or a font-awesome tile, mirroring web.AppIconCommand. -->
              <img t-if="tile.icon.src"
                   class="o_app_icon o_mad_tile_icon"
                   t-att-src="tile.icon.src" alt="" aria-hidden="true"/>
              <span t-else=""
                    class="o_app_icon o_mad_tile_icon o_mad_tile_icon_font d-flex align-items-center justify-content-center"
                    aria-hidden="true"
                    t-attf-style="background-color: {{ tile.icon.backgroundColor }};">
                <i t-att-class="tile.icon.iconClass"
                   t-attf-style="color: {{ tile.icon.color }};"/>
              </span>

              <span class="o_mad_tile_label" t-esc="tile.name"/>

              <!--
                Pin.
                  .stop     - DropdownItem's root has t-on-click.stop="onClick" and
                              closingMode "all"; without this the click would
                              navigate AND close the popover.
                  .prevent  - the DropdownItem root is an <a href>.
                  tabindex  - Tab is owned by the Dropdown navigator; keyboard
                              users toggle with Space (see navbar_patch.js).
                  aria-hidden - a focusable control inside role="menuitem" is an
                              ARIA violation; the state is on the tile's
                              aria-label instead. `title` still shows on hover.

                It is dimmed rather than hidden when unpinned. A fully
                transparent control is undiscoverable, and hoot-dom treats
                opacity:0 as invisible, which makes it unreachable from tours.
              -->
              <button type="button"
                      class="o_mad_pin btn btn-link border-0 p-0"
                      t-att-class="{ 'o_mad_pin_on': tile.isFavorite }"
                      tabindex="-1"
                      aria-hidden="true"
                      t-att-title="pinTitle(tile)"
                      t-on-click.stop.prevent="() => this.toggleFavorite(tile)">
                <i class="fa" t-att-class="tile.isFavorite ? 'fa-star' : 'fa-star-o'"/>
              </button>

            </DropdownItem>
          </div>
        </div>
      </t>
    </div>
  </t>

</templates>
